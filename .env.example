# ==============================================================================
# DataSphere / CortexDB AI Agent 配置文件示例 (.env.example)
# 请复制本文件为 .env 并填入您真实的 API Key：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 大模型服务商与接口配置 (兼容 OpenAI 规范)
# ------------------------------------------------------------------------------
# 你的 API Key (必需填入有效 key，切勿提交到代码仓库)
OPENAI_API_KEY=your_api_key_here

# API 请求的基础地址 (Base URL)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主模型名称
MODEL_NAME=qwen3.7-plus

# 生成多样性控制 (0.0 表示严格精准，适合 SQL 与数据诊断)
TEMPERATURE=0.0

# (可选) 意图分流路由器模型，若不填则默认复用 MODEL_NAME
# ROUTER_MODEL=gpt-4o-mini

# (可选) 专家 DBA 诊断/规划大模型，若不填则默认复用 MODEL_NAME
# DBA_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 2. Agent 运行限制与策略
# ------------------------------------------------------------------------------
AGENT_MAX_RETRIES=3
AGENT_MAX_RESULT_ROWS=1000
AGENT_MAX_CONTEXT_ROWS=100
AGENT_TIMEOUT=300

# 安全策略 (是否允许写操作、是否允许DDL建表删表操作)
AGENT_ALLOW_WRITE=true
AGENT_ALLOW_DDL=true
AGENT_REQUIRE_APPROVAL=false

# ------------------------------------------------------------------------------
# 3. 数据库与服务配置
# ------------------------------------------------------------------------------
CORTEX_DATA_DIR=data
CORTEX_DB_POOL_SIZE=10
CORTEX_API_HOST=127.0.0.1
CORTEX_API_PORT=8000
